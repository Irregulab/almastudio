{
  "expo": {
    "name": "AlmaStudio",
    "slug": "almastudio-companion",
    "owner": "irregulab",
    "version": "1.0.0",
    "scheme": "almastudio",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1e1e1e",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1e1e"
    },
    "ios": {
      "bundleIdentifier": "com.irregulab.almastudio.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "AlmaStudio connects to your computer on the local network to show its terminals and agents.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "TH963HHSMC",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.irregulab.almastudio.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e1e1e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AlmaStudio uses the camera to scan the pairing code shown on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AlmaStudio can ask for Face ID before showing your computer's terminals."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7cb518"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "168a6010-63bf-4807-822c-9fe05150d70a"
      }
    }
  }
}
